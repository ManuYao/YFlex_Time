 "lit_f4492e9e": "Fin dans",
 "lit_b931659f": "de repos.",
 "lit_6c1d6667": "de travail.",
 "lit_483cda90": "Go !",
 "lit_272e0fd0": "Allez, c'est parti !",
 "lit_ac71963f": "On y va !",
 "lit_e0b716cc": "Envoie !",
 "lit_ed3c0089": "C'est reparti !",
 "lit_be21f3d6": "Repos, souffle.",
 "lit_5790609b": "Pause, respire.",
 "lit_67798cce": "Bien joué, récupère.",
 "lit_a838c6db": "Souffle un coup.",
 "lit_e780040e": "Dernier tour, tout ce qui te reste !",
 "lit_db8fdcbe": "Dernier tour, on lâche rien !",
 "lit_4ca49e86": "C'est le dernier, envoie tout !",
 "lit_f1292b31": "Moitié de l'effort, garde ce rythme !",
 "lit_d8da7369": "Mi-effort, continue comme ça !",
 "lit_d359a020": "La moitié de l'effort, tiens bon !",
 "lit_14866291": "La moitié, t'es dans le rythme !",
 "lit_47f4ff31": "Mi-chemin, continue comme ça !",
 "lit_38f3d367": "Déjà la moitié, garde ce rythme !",
 "lit_d1dbe8b1": "Presque fini, tiens bon !",
 "lit_44a7629d": "La fin approche, pousse !",
 "lit_7d07b712": "Encore un peu, t'y es presque !",
 "lit_485e71a3": "Dix secondes, tout donner !",
 "lit_6f7cf812": "Plus que dix secondes, finis fort !",
 "lit_6a348144": "Dix secondes, accélère !",
 "lit_150e6d6a": "Garde le rythme, t'es bien !",
 "lit_771c30b3": "Tu gères, continue !",
 "lit_1983ad3d": "Respire, reste régulier.",
 "lit_bb15ab07": "Allez, on lâche rien !",
 "lit_95be3fb8": "Solide, continue comme ça !",
 "lit_3b2ec0e1": "Moitié du repos, respire profondément.",
 "lit_11b13fe7": "Tu récupères bien, relâche les épaules.",
 "lit_65b8142e": "Profite, respire bien.",
 "lit_518aa23f": "Dix secondes, prépare-toi !",
 "lit_b7d9a29c": "Plus que dix secondes, en place !",
 "lit_dc4528b9": "Dix secondes, on se remet en position !",
 "lit_200968dd": "Mi-tour. Si tu as fini, souffle.",
 "lit_abb7174d": "Moitié du tour, termine proprement.",
 "lit_659700a5": "Mi-tour, récupère si tu as terminé.",
 "lit_b700e4ed": "Dix secondes, prépare le prochain tour !",
 "lit_e341e3e4": "Plus que dix secondes, mets-toi en place !",
 "lit_7aae0256": "Dix secondes, prochaine vague !",
 "lit_99bd1f98": "Moitié de la séance !",
 "lit_d9852b77": "La moitié de la séance est faite, continue !",
 "lit_d1e6c6f5": "Mi-séance, t'es dans le rythme !",
 "lit_3ee7861f": "Bientôt la fin de la séance, tiens bon !",
 "lit_8e5f3ae7": "Dernière ligne droite !",
 "lit_99e116fa": "La séance se termine bientôt !",
 "lit_842b2f9e": "Dix secondes et c'est terminé !",
 "lit_f3e5d1ca": "Plus que dix secondes de séance !",
 "lit_347c70e0": "Dix secondes, on termine !",
 "lit_aa3b4cf8": "Terminé ! Énorme séance !",
 "lit_6778ecd3": "C'est fini, bravo, t'as tout donné !",
 "lit_e4f45772": "Séance bouclée, respect !",
 "lit_935f5a7a": "Plus que deux tours !",
 "lit_76832a94": "Encore deux tours, on tient !",
