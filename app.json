{
  "expo": {
    "name": "Flex Timer",
    "slug": "flex-timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "flextimer",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.flextimer.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.flextimer.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
