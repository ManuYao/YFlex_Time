{
  "expo": {
    "name": "Flex Timer",
    "slug": "flex-timer",
    "version": "15.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "flextimer",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.flextimer.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "package": "com.flextimer.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000"
        }
      ],
      "expo-mail-composer",
      "./plugins/withTimerForegroundService",
      "./plugins/withMinWindowSize",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85fc0368-09be-4ae2-86da-fb93de5bac8d"
      },
      "supabaseUrl": "https://rtfihbuhuraicbqoitpm.supabase.co",
      "supabaseAnonKey": "sb_publishable_dLkx1YAEzolbSrsUwd_GwA_UFZAD7FU"
    },
    "owner": "yao225",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/85fc0368-09be-4ae2-86da-fb93de5bac8d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
